{
  "appId": "com.oredakenonews.ironlog",
  "appName": "AIron.log",
  "webDir": "dist",
  "backgroundColor": "#0B0D10",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0B0D10",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#0B0D10",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0D10"
    }
  }
}